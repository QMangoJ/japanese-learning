{
  "title": "数字表达速查",
  "title_jp": "数の表現",
  "intro": "日语里跟数字有关的说法特殊变化最多、最容易记混。这里把「音变规律 → 基本数字 → 时间 → 日期 → 期间 → 量词 → 疑问词」串成一条线，带 ★ 的都是不规则读法，是真正需要背的地方。",
  "sections": [
    {
      "id": "rule",
      "title": "音变规律",
      "title_jp": "音の変化",
      "type": "rules",
      "lead": "先看规律再背表，能省一大半力气。绝大多数「不规则」其实只有一条主线：量词开头是 か・さ・た・は行 时，遇到 1・6・8・10 会促音化（っ），は行还会额外半浊音化（ぱ行）。",
      "groups": [
        {
          "h": "① 量词以 か行 开头 → 1・6・8・10 加「っ」",
          "eg": "回：いっかい・ろっかい・はっかい・じゅっかい　／　個：いっこ・ろっこ・はっこ・じゅっこ　／　軒：いっけん・ろっけん・はっけん・じゅっけん",
          "note": "部分还会在 3 和「何」处浊化：三階 さんがい・何階 なんがい、三軒 さんげん・何軒 なんげん。"
        },
        {
          "h": "② 量词以 さ行・た行 开头 → 1・8・10 加「っ」（6 不变）",
          "eg": "冊：いっさつ・はっさつ・じゅっさつ　／　歳：いっさい・はっさい・じゅっさい　／　着：いっちゃく・はっちゃく・じゅっちゃく",
          "note": "3 有时浊化：三足 さんぞく・何足 なんぞく。"
        },
        {
          "h": "③ 量词以 は行 开头 → 1・6・8・10 变「っ＋ぱ行」，3 和「何」变「ば行」",
          "eg": "本：いっぽん・さんぼん・ろっぽん・はっぽん・じゅっぽん・なんぼん　／　杯：いっぱい・さんばい・ろっぱい・はっぱい・じゅっぱい・なんばい　／　匹：いっぴき・さんびき・ろっぴき・はっぴき・じゅっぴき・なんびき",
          "note": "这一条最常考。记住「1・6・8・10 → ぱ行；3・何 → ば行」。"
        },
        {
          "h": "④ 例外：「〜分」的 3・4・何 不浊化，仍读「ぷん」",
          "eg": "三分 さんぷん（✗さんぶん）　／　四分 よんぷん　／　何分 なんぷん",
          "note": "对比：三本 さんぼん、三杯 さんばい、三匹 さんびき 都浊化，只有「分」不浊化，单独记。"
        },
        {
          "h": "⑤ 以 ま・な・ら・わ行 或 が・ざ・だ・ば行 开头 → 完全不变",
          "eg": "枚：いちまい〜じゅうまい　／　台：いちだい〜じゅうだい　／　人：さんにん・よにん…　／　年：いちねん・にねん…",
          "note": "这类量词只需注意 4・7・9 用哪个数字读法（よん／なな／きゅう）。"
        },
        {
          "h": "⑥ 4・7・9 的读法选择",
          "eg": "4 → よん（少数场合 し：四月 しがつ・四時 よじ）　／　7 → なな 或 しち　／　9 → きゅう 或 く（九時 くじ・九月 くがつ）",
          "note": "口语里 4 多用「よん」、7 多用「なな」以避免听错；但时间和月份有固定读法，不能换。"
        }
      ]
    },
